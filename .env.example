# ==============================================================================
# Jobcenter-Wohnungs-Matcher (Gelsenkirchen Edition) - Environment Variables
# Copy to .env on local dev or configure these directly in Coolify!
# ==============================================================================

# --- PostgreSQL (Docker Stack on VPS) ---
POSTGRES_DB=jcimmo
POSTGRES_USER=jcimmo_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# --- Backend API & Scraper ---
PORT=3001
NODE_ENV=production
# In Docker Compose this is constructed automatically, or set explicitly:
DATABASE_URL=postgresql://jcimmo_user:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/jcimmo

# Secret key for /api/admin/* (MUST be strong random string, e.g. openssl rand -hex 32)
ADMIN_SECRET_KEY=CHANGE_ME_LONG_RANDOM_ADMIN_SECRET_KEY

# Optional secret for POST /api/webhook/ingest (falls back to ADMIN_SECRET_KEY if empty)
WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET

# Optional HTTP/SOCKS Proxy for got-scraping (e.g. http://user:pass@host:port)
PROXY_URL=

# CORS allowed origins (comma-separated)
CORS_ORIGINS=https://immo.autoacts.link,http://localhost:4000,http://127.0.0.1:4000

# Enable/disable background cron schedules inside backend (true/false)
ENABLE_CRON=true

# --- Frontend (Next.js) ---
# Internal Docker URL from frontend -> backend
BACKEND_INTERNAL_URL=http://backend:3001
# Public canonical URL
NEXT_PUBLIC_SITE_URL=https://immo.autoacts.link

# --- Local Admin Dashboard (/admin-local/.env) ---
# Put these in /admin-local/.env (NOT in root .env on VPS)
# ADMIN_PORT=4000
# BACKEND_API_URL=https://immo.autoacts.link
# ADMIN_SECRET_KEY=CHANGE_ME_LONG_RANDOM_ADMIN_SECRET_KEY
